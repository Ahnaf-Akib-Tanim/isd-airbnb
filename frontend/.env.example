# ============================================================
# ISD Airbnb - Frontend Environment Variables
# Copy this file to .env.local for local development
# NEVER commit .env.local to version control
# ============================================================

# --------------------------
# API Configuration
# --------------------------
REACT_APP_API_BASE_URL=http://localhost:8080
REACT_APP_ENV=development

# --------------------------
# Service Endpoints (optional - if calling services directly)
# --------------------------
REACT_APP_USER_SERVICE_URL=http://localhost:8081
REACT_APP_BOOKING_SERVICE_URL=http://localhost:8082
REACT_APP_PAYMENT_SERVICE_URL=http://localhost:8083
REACT_APP_LISTING_SERVICE_URL=http://localhost:8084
REACT_APP_AVAILABILITY_SERVICE_URL=http://localhost:8085
REACT_APP_SEARCH_SERVICE_URL=http://localhost:8086
REACT_APP_NOTIFICATION_SERVICE_URL=http://localhost:8087
REACT_APP_ADMIN_SERVICE_URL=http://localhost:8088

# --------------------------
# App Config
# --------------------------
REACT_APP_NAME=ISD Airbnb
REACT_APP_VERSION=1.0.0

# --------------------------
# Pagination Defaults
# --------------------------
REACT_APP_DEFAULT_PAGE_SIZE=10

# --------------------------
# Map / Location (optional)
# --------------------------
REACT_APP_MAPS_API_KEY=your_google_maps_api_key_here
