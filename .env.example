# =============================================================
# ISD Airbnb - Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
# =============================================================

# --------------------------
# MongoDB Atlas URIs
# Every service must point to Atlas.
# No local MongoDB fallback is used in docker-compose.yml anymore.
# --------------------------
MONGO_URI_USER=mongodb+srv://tanim:admin@cluster0.84zkttd.mongodb.net/userdb?retryWrites=true&w=majority&appName=cluster0
MONGO_URI_BOOKING=mongodb+srv://tanim:admin@cluster0.84zkttd.mongodb.net/bookingdb?retryWrites=true&w=majority&appName=cluster0
MONGO_URI_PAYMENT=mongodb+srv://tanim:admin@cluster0.84zkttd.mongodb.net/paymentdb?retryWrites=true&w=majority&appName=cluster0
MONGO_URI_LISTING=mongodb+srv://tanim:admin@cluster0.84zkttd.mongodb.net/listingdb?retryWrites=true&w=majority&appName=cluster0
MONGO_URI_AVAILABILITY=mongodb+srv://tanim:admin@cluster0.84zkttd.mongodb.net/availabilitydb?retryWrites=true&w=majority&appName=cluster0
MONGO_URI_SEARCH=mongodb+srv://tanim:admin@cluster0.84zkttd.mongodb.net/searchdb?retryWrites=true&w=majority&appName=cluster0
MONGO_URI_NOTIFICATION=mongodb+srv://tanim:admin@cluster0.84zkttd.mongodb.net/notificationdb?retryWrites=true&w=majority&appName=cluster0
MONGO_URI_ADMIN=mongodb+srv://tanim:admin@cluster0.84zkttd.mongodb.net/admindb?retryWrites=true&w=majority&appName=cluster0

# --------------------------
# JWT Configuration
# --------------------------
JWT_SECRET=AirbnbProjectSuperSecretJwtKey2026ForAtlasOnlySecure!
JWT_EXPIRY=86400000
JWT_REFRESH_EXPIRY=604800000

# --------------------------
# Service Ports
# --------------------------
API_GATEWAY_PORT=8080
USER_SERVICE_PORT=8081
BOOKING_SERVICE_PORT=8082
PAYMENT_SERVICE_PORT=8083
LISTING_SERVICE_PORT=8084
AVAILABILITY_SERVICE_PORT=8085
SEARCH_SERVICE_PORT=8086
NOTIFICATION_SERVICE_PORT=8087
ADMIN_SERVICE_PORT=8088

# --------------------------
# Frontend
# --------------------------
REACT_APP_API_BASE_URL=http://localhost:8080
REACT_APP_ENV=development
FRONTEND_BASE_URL=http://localhost:3000

