# =============================================================
# ISD Airbnb - Environment Variables Example
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
# =============================================================

# --------------------------
# MongoDB Atlas URIs
# --------------------------
MONGO_URI_USER=mongodb+srv://tanim:tanim@cluster0.mongodb.net/userdb?retryWrites=true&w=majority&appName=ISD+Airbnb
MONGO_URI_BOOKING=mongodb+srv://tanim:tanim@cluster0.mongodb.net/bookingdb?retryWrites=true&w=majority&appName=ISD+Airbnb
MONGO_URI_PAYMENT=mongodb+srv://tanim:tanim@cluster0.mongodb.net/paymentdb?retryWrites=true&w=majority&appName=ISD+Airbnb
MONGO_URI_LISTING=mongodb+srv://tanim:tanim@cluster0.mongodb.net/listingdb?retryWrites=true&w=majority&appName=ISD+Airbnb
MONGO_URI_AVAILABILITY=mongodb+srv://tanim:tanim@cluster0.mongodb.net/availabilitydb?retryWrites=true&w=majority&appName=ISD+Airbnb
MONGO_URI_SEARCH=mongodb+srv://tanim:tanim@cluster0.mongodb.net/searchdb?retryWrites=true&w=majority&appName=ISD+Airbnb
MONGO_URI_NOTIFICATION=mongodb+srv://tanim:tanim@cluster0.mongodb.net/notificationdb?retryWrites=true&w=majority&appName=ISD+Airbnb
MONGO_URI_ADMIN=mongodb+srv://tanim:tanim@cluster0.mongodb.net/admindb?retryWrites=true&w=majority&appName=ISD+Airbnb

# --------------------------
# JWT Configuration
# --------------------------
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRY=86400000

# --------------------------
# Service Ports
# --------------------------
API_GATEWAY_PORT=8080
USER_SERVICE_PORT=8081
BOOKING_SERVICE_PORT=8082
PAYMENT_SERVICE_PORT=8083
LISTING_SERVICE_PORT=8084
AVAILABILITY_SERVICE_PORT=8085
SEARCH_SERVICE_PORT=8086
NOTIFICATION_SERVICE_PORT=8087
ADMIN_SERVICE_PORT=8088

# --------------------------
# Email / Notification Service
# --------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# --------------------------
# Frontend
# --------------------------
REACT_APP_API_BASE_URL=http://localhost:8080
REACT_APP_ENV=development

# --------------------------
# Docker / Deployment
# --------------------------
DOCKER_REGISTRY=docker.io
DOCKER_IMAGE_PREFIX=isd-airbnb
